# Local development only. Generate distinct credentials and share them separately.
DATABASE_URL=postgresql+psycopg://restock:restock_dev@localhost:5432/restock
MANAGER_USERNAME=manager
MANAGER_PASSWORD=
AGENT_TOKEN=
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:3000"]
# Hosted HTTPS: true. HTTP development/LAN testing only: false.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_HOURS=8

# Agent runtime (configuration only; AWS credentials use the standard SDK chain).
AWS_REGION=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional standard Bedrock-compatible endpoint override supplied by the organiser.
BEDROCK_BASE_URL=
# Optional overrides; normal repository installs resolve these automatically.
OPENCLAW_EXECUTABLE=
OPENCLAW_BEDROCK_PLUGIN_PATH=
COORDINATOR_TIMEOUT_SECONDS=120
