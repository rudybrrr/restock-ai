# Local development only. Generate distinct credentials and share them separately.
DATABASE_URL=postgresql+psycopg://restock:restock_dev@127.0.0.1:5432/restock
MANAGER_USERNAME=manager
MANAGER_PASSWORD=
AGENT_TOKEN=
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:3000"]
# Hosted HTTPS: true. HTTP development/LAN testing only: false.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_HOURS=8
# Opt-in fixture for backend workflow testing only; not the ML optimiser.
ENABLE_DEVELOPMENT_CALCULATOR=false

# Agent/LLM runtime (organiser-provided gateway configuration).
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_MODEL=
LLM_GATEWAY_TIMEOUT_SECONDS=30
LLM_NUM_PREDICT=2048
# Optional overrides; normal repository installs resolve these automatically.
OPENCLAW_EXECUTABLE=
COORDINATOR_TIMEOUT_SECONDS=120
